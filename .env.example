PORT=4001
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/skill99_crm?schema=public"
# Supabase direct connection, used by Prisma migrations. Use the direct 5432 URL.
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Razorpay subscription checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Website enquiry routing. Leave blank for demo/single-tenant mode; the backend will route to the first active company.
PUBLIC_LEAD_COMPANY_ID=

SEED_ADMIN_EMAIL=admin@skill99.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_OWNER_EMAIL=owner@skill99.com
SEED_OWNER_PASSWORD=Admin@123
SEED_ADMIN_NAME=Skill99 Admin
SEED_SOLO_EMAIL=solo@skill99.com
SEED_SOLO_PASSWORD=Solo@12345
SEED_SOLO_PHONE=
SEED_COMPANY_ADMIN_EMAIL=companyadmin@skill99.com
SEED_COMPANY_ADMIN_PASSWORD=Admin@12345
SEED_TL_PASSWORD=Tl@12345
SEED_SALES_PASSWORD=Sales@123

# WhatsApp OTP / member activation
# Use `console` for local development. For production use `meta` or `twilio`.
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=skill99_crm_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Twilio WhatsApp provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Automated communications
EMAIL_PROVIDER=smtp
EMAIL_FROM=Skill99 CRM <your-email@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-gmail-app-password
AUTOMATION_LEAD_ACK_EMAIL=true
AUTOMATION_LEAD_ACK_WHATSAPP=true
AUTOMATION_STAGE_EMAIL=true
AUTOMATION_STAGE_WHATSAPP=true
AUTOMATION_INTEREST_EMAIL=true
AUTOMATION_INTEREST_WHATSAPP=true
WHATSAPP_LEAD_WELCOME_TEMPLATE=skill99_lead_welcome
WHATSAPP_STAGE_TEMPLATE=skill99_lead_stage
WHATSAPP_INTEREST_TEMPLATE=skill99_lead_stage
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verification-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Mobile caller / call storage
CALL_DEVICE_HEARTBEAT_SECONDS=30

# Storage: use `local` for development or `r2` in production.
STORAGE_PROVIDER=local
RECORDINGS_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public/custom-domain URL, without a trailing slash.
R2_PUBLIC_URL=
