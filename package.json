{
  "name": "skill99-crm-backend",
  "version": "1.0.0",
  "description": "Skill99 CRM API — standalone admin & sales backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "render-build": "npm run db:generate && npm run db:migrate:deploy && npm run db:seed:plans",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:plans": "node prisma/seed-plans.js",
    "db:repair-auth": "node prisma/repair-auth.js",
    "db:repair-schema": "node prisma/repair-schema.js",
    "db:backfill-multitenant": "node prisma/backfill-multitenant.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "razorpay": "^2.9.8",
    "react-router-dom": "^7.18.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
